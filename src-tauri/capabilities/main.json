{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local bundled main window may use the scoped GitLab session and signed updater.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-runtime-info",
    "allow-connect-gitlab",
    "allow-list-glab-connections",
    "allow-connect-gitlab-from-glab",
    "allow-restore-session",
    "allow-disconnect-gitlab",
    "allow-query-gitlab",
    "allow-mutate-gitlab",
    "allow-clear-gitlab-cache",
    "allow-cancel-gitlab-request",
    "allow-open-gitlab-url",
    "allow-get-gitlab-avatar",
    "allow-check-app-update",
    "allow-install-app-update",
    "allow-get-local-draft",
    "allow-set-local-draft",
    "allow-clear-local-drafts",
    "allow-get-pending-operation",
    "allow-acknowledge-pending-operation",
    "allow-set-window-close-guard",
    "allow-close-app-window",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
